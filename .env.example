# Database Connection
# Example: postgresql://user:password@localhost:5432/mydb?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# NextAuth Configuration
# The URL of your application, used for callback URLs, etc.
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong secret for NextAuth.js.
# On Linux/macOS, you can use: openssl rand -base64 32
# This is used to sign cookies and tokens.
NEXTAUTH_SECRET="your_strong_nextauth_secret_here"

# Razorpay API Keys
# Obtain these from your Razorpay Dashboard (Test or Live mode)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_test_or_live_key_secret"

# This is your Razorpay Key ID again, prefixed for client-side availability
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# This secret is configured in your Razorpay Dashboard when setting up webhooks.
# It's used to verify that webhook requests are genuinely from Razorpay.
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_very_secure"

# OpenAI API Key
# Obtain this from your OpenAI Dashboard
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
